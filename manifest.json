{
  "name": "Protocol7",
  "version": "1.0.0",
  "author": "dcqwqc",
  "homepage": "https://github.com/dcqwqc/CaelestiaPlugin-Protocol7",
  "icon": "mic",
  "description": "Protocol7 voice dictation plus Hey Tabby, the wake-word ChatGPT Voice companion with persistent hidden WebView and whiteboard.",
  "entryPoints": [
    {
      "type": "custom",
      "source": "entry/Main.qml"
    },
    {
      "type": "shell-panel",
      "source": "Panel.qml",
      "properties": {
        "edge": "bottom",
        "alignment": "center",
        "interactive": false,
        "deformAmount": 0.03,
        "motionDuration": 180
      }
    },
    {
      "type": "shell-panel",
      "source": "CompanionPanel.qml",
      "properties": {
        "edge": "top",
        "alignment": "center",
        "interactive": false,
        "deformAmount": 0.025,
        "motionDuration": 180
      }
    }
  ],
  "settings": "Settings.qml",
  "settingsUi": "SettingsUi.qml"
}
